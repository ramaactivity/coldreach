# ============================================================================
# ColdReach — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# .env.local TIDAK di-commit ke git (sudah di .gitignore).
# ============================================================================

# ----- Supabase (Database, Auth, Storage, Edge Functions) -----
# Dapat dari: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SERVICE ROLE KEY — JANGAN PERNAH expose ke client!
# Cuma dipakai di server-side (route handlers, server actions, edge functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----- Google OAuth (Login + Gmail API) -----
# Dapat dari: https://console.cloud.google.com/apis/credentials
# Buat OAuth 2.0 Client ID type "Web application"
# Authorized redirect URIs:
#   - http://localhost:3000/auth/callback (local dev)
#   - https://your-app.vercel.app/auth/callback (production)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ----- Google Gemini (AI Personalization) -----
# Dapat dari: https://aistudio.google.com/apikey
# Free tier: 1500 requests/day
GEMINI_API_KEY=your-gemini-api-key

# ----- App Config -----
# URL publik aplikasi. Saat dev = http://localhost:3000.
# Saat production = https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron secret — random string buat protect endpoint cron dari panggilan luar
# Generate via: openssl rand -hex 32
CRON_SECRET=generate-random-secret-here

# Encryption key for Gmail OAuth tokens at rest (AES-256-GCM, 32 bytes hex)
# Generate via: openssl rand -hex 32
ENCRYPTION_KEY=generate-random-32-byte-hex-here
